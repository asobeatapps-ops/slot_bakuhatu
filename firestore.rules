rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{userId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['name', 'score', 'achievedAt'])
          && d.keys().hasOnly(['name', 'score', 'achievedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
          && d.score is int && d.score >= 0 && d.score <= 1000000
          && d.achievedAt is timestamp;
      }
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 100;
      allow create: if owner() && valid() && request.resource.data.achievedAt == request.time;
      allow update: if owner() && valid() && (
        (request.resource.data.score > resource.data.score
          && request.resource.data.achievedAt == request.time)
        || (request.resource.data.score == resource.data.score
          && request.resource.data.achievedAt == resource.data.achievedAt)
      );
      allow delete: if false;
    }
  }
}
