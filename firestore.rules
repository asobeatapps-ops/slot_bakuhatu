rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{userId} {
      function signedInOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validRecord() {
        return request.resource.data.keys().hasOnly(['name','bestHeight','bestTitle','achievedAt'])
          && request.resource.data.keys().hasAll(['name','bestHeight','bestTitle','achievedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 16
          && request.resource.data.bestHeight is int
          && request.resource.data.bestHeight >= 0
          && request.resource.data.bestHeight <= 1000000
          && request.resource.data.bestTitle is string
          && request.resource.data.bestTitle.size() <= 40
          && request.resource.data.achievedAt is timestamp;
      }
      allow get, list: if true;
      allow create: if signedInOwner() && validRecord()
        && request.resource.data.achievedAt == request.time;
      allow update: if signedInOwner() && validRecord()
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && request.resource.data.bestHeight == resource.data.bestHeight
            && request.resource.data.achievedAt == resource.data.achievedAt)
          ||
          (request.resource.data.bestHeight > resource.data.bestHeight
            && request.resource.data.achievedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bestHeight','bestTitle','achievedAt']))
        );
      allow delete: if false;
    }
  }
}
